<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<window>
    <resolution>720p</resolution>
    <useincludes>false</useincludes>
    <defaultcontrol>100</defaultcontrol>
    <allowoverlay>false</allowoverlay>
    <type>dialog</type>

    <!-- 100 = list -->
    <!-- 200 = back -->
    <!-- 300 = play -->
    <!-- 400 = next -->
    <!-- 500 = station logo -->

    <coordinates>
        <system>1</system>
        <posx>0</posx>
        <posy>0</posy>
    </coordinates>

    <controls>
        <control type="image">
            <visible>!Window.IsVisible(Visualisation)</visible>
            <posx>0</posx><posy>0</posy>
            <width>1280</width><height>720</height>
            <texture>1px-black.png</texture>
        </control>

        <control type="group">
            <control type="group">
                <animation effect="fade" time="300">VisibleChange</animation>

                <!-- Background -->
                <control type="image">
                    <posx>0</posx><posy>0</posy>
                    <width>1280</width><height>720</height>
                    <texture border="20,10,10,30">panel.jpg</texture>
                    <aspectratio>stretch</aspectratio>
                </control>

                <!-- Left dark panel -->
                <control type="image">
                    <posx>0</posx><posy>0</posy>
                    <width>530</width><height>720</height>
                    <texture colordiffuse="E0060A10">1px-black.png</texture>
                </control>

                <!-- Station list -->
                <control type="group">
                    <posx>10</posx><posy>10</posy>
                    <control type="group">
                        <animation effect="fade" reversible="true" time="300">VisibleChange</animation>
                        <control type="list" id="100">
                            <width>510</width>
                            <height>700</height>
                            <onleft>400</onleft>
                            <onright>200</onright>
                            <onup>100</onup>
                            <ondown>100</ondown>
                            <viewtype label="535">list</viewtype>
                            <scrolltime>200</scrolltime>

                            <itemlayout height="58">
                                <!-- Row separator -->
                                <control type="image">
                                    <posx>0</posx><posy>57</posy>
                                    <width>510</width><height>1</height>
                                    <texture colordiffuse="22FFFFFF">1px-black.png</texture>
                                </control>
                                <!-- Playing: green left bar -->
                                <control type="image">
                                    <posx>0</posx><posy>0</posy>
                                    <width>4</width><height>57</height>
                                    <texture border="2" colordiffuse="FF00BB55">twc-input-nofocus.png</texture>
                                    <visible>String.IsEqual(ListItem.Property(Id),Window.Property(PlayingStationId))</visible>
                                </control>
                                <!-- Logo -->
                                <control type="image">
                                    <posx>12</posx><posy>7</posy>
                                    <width>44</width><height>44</height>
                                    <aspectratio>keep</aspectratio>
                                    <texture>$INFO[ListItem.Property(Icon)]</texture>
                                </control>
                                <!-- Name: green if playing -->
                                <control type="label">
                                    <posx>64</posx><posy>9</posy>
                                    <width>438</width><height>26</height>
                                    <font>font12</font>
                                    <aligny>center</aligny>
                                    <textcolor>FF00CC66</textcolor>
                                    <align>left</align>
                                    <info>ListItem.Label2</info>
                                    <visible>String.IsEqual(ListItem.Property(Id),Window.Property(PlayingStationId))</visible>
                                </control>
                                <control type="label">
                                    <posx>64</posx><posy>9</posy>
                                    <width>438</width><height>26</height>
                                    <font>font12</font>
                                    <aligny>center</aligny>
                                    <textcolor>CCFFFFFF</textcolor>
                                    <align>left</align>
                                    <info>ListItem.Label2</info>
                                    <visible>!String.IsEqual(ListItem.Property(Id),Window.Property(PlayingStationId))</visible>
                                </control>
                                <!-- Country -->
                                <control type="label">
                                    <posx>64</posx><posy>35</posy>
                                    <width>438</width><height>18</height>
                                    <font>font10</font>
                                    <aligny>center</aligny>
                                    <textcolor>66FFFFFF</textcolor>
                                    <align>left</align>
                                    <info>ListItem.Property(Country)</info>
                                </control>
                            </itemlayout>

                            <focusedlayout height="58">
                                <!-- Focus highlight (dark red) -->
                                <control type="image">
                                    <posx>0</posx><posy>0</posy>
                                    <width>510</width><height>57</height>
                                    <visible>Control.HasFocus(100)</visible>
                                    <texture border="3" colordiffuse="EE7A1010">twc-input-nofocus.png</texture>
                                </control>
                                <!-- Dim when list unfocused -->
                                <control type="image">
                                    <posx>0</posx><posy>0</posy>
                                    <width>510</width><height>57</height>
                                    <visible>!Control.HasFocus(100)</visible>
                                    <texture border="3" colordiffuse="AA404040">twc-input-nofocus.png</texture>
                                </control>
                                <!-- Row separator -->
                                <control type="image">
                                    <posx>0</posx><posy>57</posy>
                                    <width>510</width><height>1</height>
                                    <texture colordiffuse="33FFFFFF">1px-black.png</texture>
                                </control>
                                <!-- Playing: green left bar -->
                                <control type="image">
                                    <posx>0</posx><posy>0</posy>
                                    <width>4</width><height>57</height>
                                    <texture border="2" colordiffuse="FF00BB55">twc-input-nofocus.png</texture>
                                    <visible>String.IsEqual(ListItem.Property(Id),Window.Property(PlayingStationId))</visible>
                                </control>
                                <!-- Logo -->
                                <control type="image">
                                    <posx>12</posx><posy>7</posy>
                                    <width>44</width><height>44</height>
                                    <aspectratio>keep</aspectratio>
                                    <texture>$INFO[ListItem.Property(Icon)]</texture>
                                </control>
                                <!-- Name -->
                                <control type="label">
                                    <posx>64</posx><posy>9</posy>
                                    <width>435</width><height>26</height>
                                    <font>font12</font>
                                    <style>bold</style>
                                    <aligny>center</aligny>
                                    <textcolor>FFFFFFFF</textcolor>
                                    <align>left</align>
                                    <info>ListItem.Label2</info>
                                </control>
                                <!-- Country -->
                                <control type="label">
                                    <posx>64</posx><posy>35</posy>
                                    <width>435</width><height>18</height>
                                    <font>font10</font>
                                    <aligny>center</aligny>
                                    <textcolor>BBFFFFFF</textcolor>
                                    <align>left</align>
                                    <info>ListItem.Property(Country)</info>
                                </control>
                            </focusedlayout>
                        </control>
                    </control>
                </control>

                <!-- Right panel -->
                <control type="group">
                    <posx>550</posx>
                    <posy>0</posy>

                    <!-- Playing station name (green, top) -->
                    <control type="label">
                        <posx>30</posx><posy>18</posy>
                        <width>680</width><height>36</height>
                        <font>font13</font>
                        <style>bold</style>
                        <textcolor>FF00CC66</textcolor>
                        <align>left</align>
                        <scroll>true</scroll>
                        <visible>Player.HasMedia</visible>
                        <info>Window.Property(PlayingStationName)</info>
                    </control>

                    <!-- Station logo -->
                    <control type="image" id="500">
                        <posx>30</posx><posy>70</posy>
                        <width>660</width><height>320</height>
                        <aspectratio>keep</aspectratio>
                    </control>

                    <!-- Song title -->
                    <control type="label">
                        <posx>30</posx><posy>420</posy>
                        <width>690</width><height>44</height>
                        <font>font13</font>
                        <style>bold</style>
                        <textcolor>FFFFFFFF</textcolor>
                        <align>left</align>
                        <scroll>true</scroll>
                        <visible>Player.HasMedia</visible>
                        <info>MusicPlayer.Title</info>
                    </control>

                    <!-- Artist -->
                    <control type="label">
                        <posx>30</posx><posy>472</posy>
                        <width>690</width><height>36</height>
                        <font>font12</font>
                        <textcolor>FF999999</textcolor>
                        <align>left</align>
                        <scroll>true</scroll>
                        <visible>Player.HasMedia</visible>
                        <info>MusicPlayer.Artist</info>
                    </control>

                    <!-- Buttons: flat text style -->

                    <!-- Prev station -->
                    <control type="button" id="200">
                        <posx>100</posx><posy>580</posy>
                        <width>100</width><height>80</height>
                        <onleft>100</onleft>
                        <onright>300</onright>
                        <onup>100</onup>
                        <ondown>100</ondown>
                        <texturefocus colordiffuse="EE9B1A1A">twc-input-nofocus.png</texturefocus>
                        <texturenofocus colordiffuse="44FFFFFF">twc-input-nofocus.png</texturenofocus>
                        <label>|◄</label>
                        <font>font16</font>
                        <textcolor>FFFFFFFF</textcolor>
                        <focusedcolor>FFFFFFFF</focusedcolor>
                        <align>center</align>
                        <aligny>center</aligny>
                    </control>

                    <!-- Play/Pause toggle -->
                    <control type="togglebutton" id="300">
                        <posx>245</posx><posy>570</posy>
                        <width>120</width><height>100</height>
                        <label>-</label>
                        <onleft>200</onleft>
                        <onright>400</onright>
                        <onup>100</onup>
                        <ondown>100</ondown>
                        <texturefocus colordiffuse="EE9B1A1A">twc-input-nofocus.png</texturefocus>
                        <texturenofocus colordiffuse="44FFFFFF">twc-input-nofocus.png</texturenofocus>
                        <alttexturefocus colordiffuse="EE1A6B1A">twc-input-nofocus.png</alttexturefocus>
                        <alttexturenofocus colordiffuse="6600BB44">twc-input-nofocus.png</alttexturenofocus>
                        <usealttexture>Player.Playing</usealttexture>
                        <onclick>XBMC.PlayerControl(Play)</onclick>
                    </control>
                    <!-- Play symbol (not playing) -->
                    <control type="label">
                        <posx>245</posx><posy>570</posy>
                        <width>120</width><height>100</height>
                        <font>font16</font>
                        <textcolor>FFFFFFFF</textcolor>
                        <align>center</align>
                        <aligny>center</aligny>
                        <label>►</label>
                        <visible>!Player.Playing</visible>
                    </control>
                    <!-- Pause symbol (playing) -->
                    <control type="label">
                        <posx>245</posx><posy>570</posy>
                        <width>120</width><height>100</height>
                        <font>font16</font>
                        <textcolor>FFFFFFFF</textcolor>
                        <align>center</align>
                        <aligny>center</aligny>
                        <label>||</label>
                        <visible>Player.Playing</visible>
                    </control>

                    <!-- Next station -->
                    <control type="button" id="400">
                        <posx>420</posx><posy>580</posy>
                        <width>100</width><height>80</height>
                        <onleft>300</onleft>
                        <onright>100</onright>
                        <onup>100</onup>
                        <ondown>100</ondown>
                        <texturefocus colordiffuse="EE9B1A1A">twc-input-nofocus.png</texturefocus>
                        <texturenofocus colordiffuse="44FFFFFF">twc-input-nofocus.png</texturenofocus>
                        <label>►|</label>
                        <font>font16</font>
                        <textcolor>FFFFFFFF</textcolor>
                        <focusedcolor>FFFFFFFF</focusedcolor>
                        <align>center</align>
                        <aligny>center</aligny>
                    </control>
                </control>

            </control>
        </control>
    </controls>
</window>
